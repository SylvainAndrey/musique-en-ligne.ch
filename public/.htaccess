RewriteEngine On

# Impose une seule adresse canonique : https://www.musique-en-ligne.ch
# (évite le contenu dupliqué détecté par Google Search Console sur les 4 variantes
# http/https × avec/sans www).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^musique-en-ligne\.ch$ [NC]
RewriteRule ^ https://www.musique-en-ligne.ch%{REQUEST_URI} [L,R=301]

# Pages déplacées ou renommées (l'ancienne page reste sur le serveur, car la mise en ligne
# ne supprime rien : on redirige donc explicitement vers la nouvelle adresse).
RewriteRule ^11h/decouverte-du-langage-musical/intervalles-et-signatures-rythmiques/?(index\.html)?$ /11h/decouverte-du-langage-musical/signatures-rythmiques/ [L,R=301]
